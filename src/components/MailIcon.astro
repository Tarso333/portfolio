---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 14 12"
  fill="none"
  stroke="currentColor"
  stroke-width="1.15"
  stroke-linejoin="round"
  class:list={["inline-block size-[0.85em] shrink-0", className]}
>
  <rect x="1" y="1.5" width="12" height="9" rx="1" />
  <path d="M1.4 2.2 7 6.6l5.6-4.4" />
</svg>
