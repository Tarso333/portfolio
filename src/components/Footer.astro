---
import { profile } from "../data/profile";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line pt-8 sm:grid sm:grid-cols-[10rem_1fr] sm:gap-6 lg:mt-36 lg:block xl:grid">
  <p class="label pt-1 text-subtle">© {year}</p>

  <p class="mt-3 text-sm leading-6 text-subtle sm:mt-0 lg:mt-3 xl:mt-0">
    {profile.fullName}. Site estático em Astro e Tailwind CSS, com tipografia IBM Plex, publicado na Vercel.
  </p>
</footer>
