---
import ArrowUpRight from "./ArrowUpRight.astro";
import MailIcon from "./MailIcon.astro";
import SectionNav from "./SectionNav.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { profile } from "../data/profile";

const links = [
  { label: "GitHub", href: profile.links.github, external: true },
  { label: "LinkedIn", href: profile.links.linkedin, external: true },
  { label: "E-mail", href: `mailto:${profile.email}`, external: false },
];
---

<header
  class="pt-16 md:pt-24 lg:sticky lg:top-0 lg:flex lg:h-dvh lg:flex-col lg:justify-between lg:self-start lg:py-24"
>
  <div>
    <h1 class="heading text-4xl text-fg sm:text-5xl">{profile.name}</h1>
    <p class="mt-3 text-lg text-fg">{profile.role}</p>
    <p class="mt-1 font-mono text-sm text-subtle">{profile.focus.join(" · ")}</p>
    <p class="mt-6 max-w-sm leading-7 text-muted">{profile.tagline}</p>

    <SectionNav class="mt-16 hidden lg:block" />
  </div>

  <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 lg:mt-0">
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-3" aria-label="Contato">
      {
        links.map((link) => (
          <li class="flex">
            <a
              href={link.href}
              class="label -my-1 inline-flex items-center gap-1.5 py-1 text-muted transition-colors hover:text-fg"
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {link.label}
              {link.external ? <ArrowUpRight /> : <MailIcon />}
              {link.external && <span class="sr-only">(abre em nova aba)</span>}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </div>
</header>
