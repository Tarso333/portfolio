---
import Card from "./Card.astro";
import CardTitle from "./CardTitle.astro";
import RichText from "./RichText.astro";
import TagList from "./TagList.astro";
import { experience } from "../data/profile";
---

<ol class="-mt-4 space-y-4">
  {
    experience.map((job) => (
      <Card interactive={Boolean(job.companyUrl)}>
        <Fragment slot="meta">{job.period}</Fragment>

        <CardTitle href={job.companyUrl}>
          {job.role} · {job.company}
        </CardTitle>
        <p class="mt-0.5 text-sm text-subtle">
          {[job.via && `via ${job.via}`, job.location].filter(Boolean).join(" · ")}
        </p>

        <p class="mt-3 text-sm leading-6 text-muted">
          <RichText text={job.summary} />
        </p>

        {job.highlights.length > 0 && (
          <ul class="mt-4 space-y-2.5">
            {job.highlights.map((item) => (
              <li class="relative pl-5 text-sm leading-6 text-muted before:absolute before:top-3 before:left-0 before:h-px before:w-2.5 before:bg-line-strong">
                <RichText text={item} />
              </li>
            ))}
          </ul>
        )}

        {job.quote && (
          <figure class="mt-6 border-l border-line-strong pl-4">
            <blockquote class="text-sm leading-6 text-fg/85">
              {/* Aspa de abertura pendurada para o texto alinhar pela letra. */}
              <p class="-indent-[0.4em]">“{job.quote.text}”</p>
            </blockquote>
            <figcaption class="label mt-2 text-subtle">{job.quote.source}</figcaption>
          </figure>
        )}

        <TagList items={job.stack} />
      </Card>
    ))
  }
</ol>
