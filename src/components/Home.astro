---
import About from "./About.astro";
import Contact from "./Contact.astro";
import Experience from "./Experience.astro";
import Footer from "./Footer.astro";
import Projects from "./Projects.astro";
import Section from "./Section.astro";
import Sidebar from "./Sidebar.astro";
import Stack from "./Stack.astro";
import Base from "../layouts/Base.astro";
import { getContent } from "../i18n";

// Página inteira, igual nos dois idiomas: src/pages/index.astro (pt) e src/pages/en/index.astro.
const c = getContent(Astro.currentLocale);
const [aboutSection, experienceSection, projectsSection, stackSection, contactSection] = c.sections;
---

<Base>
  <a
    href={`#${c.ui.mainId}`}
    class="label sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-fg focus:px-3 focus:py-2 focus:text-bg"
  >
    {c.ui.skipToContent}
  </a>

  <div class="mx-auto min-h-dvh max-w-[76rem] px-6 md:px-12 lg:px-16">
    <div class="lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16">
      <Sidebar />

      <main id={c.ui.mainId} class="pt-20 pb-16 lg:py-24">
        <Section {...aboutSection} reveal={false}>
          <About />
        </Section>

        <Section {...experienceSection} class="mt-20 lg:mt-36">
          <Experience />
        </Section>

        <Section {...projectsSection} class="mt-20 lg:mt-36">
          <Projects />
        </Section>

        <Section {...stackSection} class="mt-20 lg:mt-36">
          <Stack />
        </Section>

        <Section {...contactSection} class="mt-20 lg:mt-36">
          <Contact />
        </Section>

        <Footer />
      </main>
    </div>
  </div>
</Base>
