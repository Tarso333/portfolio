---
import ArrowUpRight from "./ArrowUpRight.astro";
import Card from "./Card.astro";
import CardTitle from "./CardTitle.astro";
import RichText from "./RichText.astro";
import TagList from "./TagList.astro";
import { profile } from "../data/profile";
import { getContent } from "../i18n";

const { projectGroups, projects, ui } = getContent(Astro.currentLocale);

// Projetos próprios primeiro; os do TRF1 depois, com um subtítulo explicando a falta de link.
// O link final fica alinhado à coluna de conteúdo dos cards: 10rem de metadado + 1.5rem de gap.
---

{
  projectGroups.map((grupo, indice) => (
    <section aria-label={grupo.label} class:list={[indice > 0 && "mt-14"]}>
      <header class="sm:grid sm:grid-cols-[10rem_1fr] sm:gap-6 lg:block xl:grid">
        <h3 class="label pt-0.5 text-fg">{grupo.label}</h3>
        <p class="mt-1 max-w-prose text-sm leading-6 text-subtle sm:mt-0 lg:mt-1 xl:mt-0">{grupo.note}</p>
      </header>

      <ul class="mt-2 space-y-4">
        {projects
          .filter((project) => project.group === grupo.id)
          .map((project) => (
            <Card interactive={Boolean(project.href)}>
              <Fragment slot="meta">
                {project.year} · {project.kind}
              </Fragment>

              <CardTitle
                href={project.href}
                hint={project.hrefKind === "demo" ? ui.demoHint : ui.repoHint}
              >
                {project.name}
              </CardTitle>
              <p class="mt-0.5 text-sm text-subtle">
                {project.context}
                {project.hrefKind === "demo" && ` · ${ui.demoBadge}`}
              </p>

              <p class="mt-3 text-sm leading-6 text-muted">
                <RichText text={project.description} />
              </p>

              <TagList items={project.stack} />
            </Card>
          ))}
      </ul>
    </section>
  ))
}

<p class="mt-10 sm:ml-[11.5rem] lg:ml-0 xl:ml-[11.5rem]">
  <a
    href={profile.links.github}
    target="_blank"
    rel="noopener noreferrer"
    class="group/all inline-flex items-baseline gap-1.5 text-sm text-muted underline decoration-subtle/50 underline-offset-4 transition-colors duration-200 hover:text-fg hover:decoration-fg"
  >
    {ui.allProjects}
    <ArrowUpRight class="transition-transform duration-300 ease-out group-hover/all:-translate-y-0.5 group-hover/all:translate-x-0.5" />
    <span class="sr-only">({ui.newTab})</span>
  </a>
</p>
