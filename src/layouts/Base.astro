---
// Só o subconjunto latino das fontes: cobre todo o português e evita baixar cirílico, grego etc.
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "../styles/global.css";

import plexSans400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import plexSans600 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url";
import plexMono400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";

import { profile } from "../data/profile";
import { getContent, homePath, languages, toLang } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const lang = toLang(Astro.currentLocale);
const c = getContent(lang);

const {
  title = `${profile.name} · ${c.role}`,
  description = c.meta.description,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(c.meta.ogImage, site);

// Cada idioma aponta para as versões equivalentes; x-default é a raiz em português.
const alternates = languages.map((code) => ({
  hreflang: getContent(code).htmlLang,
  href: new URL(homePath(code), site).href,
}));
const otherLocales = languages.filter((code) => code !== lang).map((code) => getContent(code).ogLocale);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.fullName,
  alternateName: profile.name,
  url: new URL(homePath(lang), site).href,
  image: ogImage.href,
  jobTitle: c.meta.jobTitle,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Brasília",
    addressRegion: "DF",
    addressCountry: "BR",
  },
  knowsAbout: c.meta.knowsAbout,
  sameAs: [profile.links.github, profile.links.linkedin],
};
---

<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.fullName} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090b" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={c.ogLocale} />
    {otherLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={plexSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexSans600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono400} as="font" type="font/woff2" crossorigin />

    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />}

    <script is:inline>
      // Escuro é o padrão do site; o claro fica disponível no botão e é lembrado.
      try {
        document.documentElement.dataset.theme = localStorage.getItem("theme") ?? "dark";
      } catch {
        document.documentElement.dataset.theme = "dark";
      }
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.dataset.motion = "on";
      }
    </script>
  </head>
  <body class="min-h-dvh bg-bg text-fg">
    <slot />
  </body>
</html>
